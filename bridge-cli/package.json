{
  "name": "@nebulr-group/bridge-cli",
  "version": "1.0.0-alpha.1",
  "description": "The Bridge CLI: set up your app on Bridge from the terminal. Sign in, then create apps and their addresses, keys, plans with prices and trials, Stripe in test mode, and feature flags with their rules.",
  "author": "Nebulr Group",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bridge": "dist/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "cli",
    "ai-agent",
    "claude-code",
    "cursor",
    "devtools",
    "the-bridge",
    "bridge",
    "authentication",
    "feature-flags",
    "stripe",
    "subscriptions",
    "saas",
    "management"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thebridgedev/bridge-cli"
  },
  "homepage": "https://thebridge.dev/docs/getting-started/",
  "bugs": {
    "url": "https://github.com/thebridgedev/bridge-cli/issues"
  }
